{
  "manifest_version": 3,
  "name": "SNIP-LANG",
  "description": "Học tiếng Anh thông minh — bôi đen, dịch, lưu câu",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SNIP-LANG"
  },
  "background": {
    "service_worker": "background/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["config.js", "content/content.js"],
      "css": ["theme.css", "content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "identity",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:4000/*",
    "https://snip-lang-backend.vercel.app/*"
  ]
}
