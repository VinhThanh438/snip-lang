{
  "manifest_version": 3,
  "name": "SNIP-LANG",
  "description": "Học tiếng Anh thông minh — bôi đen, dịch, lưu câu",
  "version": "1.0.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "SNIP-LANG"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "identity"
  ],
  "host_permissions": [
    "http://localhost:4000/*",
    "https://your-api-domain.com/*"
  ]
}
