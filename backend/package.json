{
  "name": "snip-lang-backend",
  "version": "1.0.0",
  "description": "SNIP-LANG Backend API — Language learning system",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node -r tsconfig-paths/register dist/server.js",
