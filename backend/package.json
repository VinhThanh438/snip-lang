    "vercel-build": "echo 'No build step needed — @vercel/node handles TS'"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
